 "radio": [
  {"on": "start", "who": "mags", "line": "That's Juno. She ran the Line with you, Parker. She knows all your tricks."},
  {"on": "start", "who": "juno", "line": "Hey, Parker. Long time. Still running for other people?"},
  {"on": "go", "who": "parker", "line": "Still running."},
  {"at": [0, 13, -441], "size": [5, 5, 6], "who": "mags", "line": "Skybridge to the car park. It goes uphill. Slide it if you've got the speed."},
  {"on": "checkpoint:0", "who": "host", "line": "Folks, it's a rematch! Nobody asked for it, and you're all gonna love it."},
  {"at": [-15.5, 19, -492], "size": [9, 5, 6], "who": "mags", "line": "These ones run like you. They'll come at you from the side. Don't stop."},
  {"on": "checkpoint:1", "who": "juno", "line": "You were always faster. I'm the one getting paid, though."},
  {"on": "checkpoint:2", "who": "juno", "line": "Come on, then. Show the city."},
  {"on": "fate:spared", "who": "juno", "line": "Go on. Get her. Before I change my mind."},
  {"on": "fate:not_spared", "who": "mags", "line": "...She was one of ours, once. Keep going."},
  {"on": "complete", "who": "host", "line": "Well. Ratings are through the roof. And you're all cheering for the wrong guy. Every one of you."},
  {"on": "complete", "who": "host", "line": "Let's, uh... let's take a quick break. Word from our sponsor."},
  {"on": "complete", "who": "vell", "line": "Port Calder. This is Commander Vell of the Ward. This broadcast has become a public safety concern. We'll be resolving it."},
  {"on": "complete", "who": "mags", "line": "Parker. Those aren't raiders."}
 ],
 "chatter": {
  "kill": [
   {"who": "host", "line": "Another hunter down! I'm docking their pay. Posthumously."},
   {"who": "juno", "line": "That one owed me money. Thanks, I guess."}
