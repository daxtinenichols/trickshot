  {"at": [-15, 7.5, -366], "size": [18, 3, 4], "who": "host", "line": "Now, Parker, while you're browsing, a word from our... what is that? Who's on my frequency?"},
  {"at": [-15, 7.5, -366], "size": [18, 3, 4], "who": "echo", "line": "Keep the porch light on, courier. I'm coming home."},
  {"at": [-15, 7.5, -366], "size": [18, 3, 4], "who": "host", "line": "Technical difficulties, folks. Nobody touch anything."},
  {"at": [-15, 7.5, -366], "size": [18, 3, 4], "who": "parker", "line": "That was her."},
  {"at": [-15, 7.5, -366], "size": [18, 3, 4], "who": "mags", "line": "That was her. She's alive. She's in his wires, Parker. Go. Run."},
  {"on": "complete", "who": "host", "line": "He's on the skybridge! And guess who's waiting for him at the other end. Go on. Guess."}
