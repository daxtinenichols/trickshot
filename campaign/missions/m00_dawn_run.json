 "radio": [
  {"on": "start", "who": "mags", "line": "Morning, Parker. One parcel, the high roof past the fish market. Don't let breakfast get cold."},
  {"on": "go", "who": "parker", "line": "On my way."},
  {"at": [0, 10, -11], "radius": 6, "who": "mags", "line": "Jump into those rails, don't just hop them. A vault keeps your speed."},
  {"at": [0, 10, -27], "radius": 6, "who": "mags", "line": "Low bar. Crouch and slide under it."},
  {"on": "checkpoint:0", "who": "mags", "line": "That door's been stuck since the storm. Kick it, or slide under the window like a civilised person."},
  {"at": [4, 10, -66], "radius": 7, "who": "mags", "line": "Gap's too wide to jump. Take the blue wall."},
  {"on": "checkpoint:1", "who": "mags", "line": "High roof's up that face. Straight at it, and jump."},
  {"on": "done:0", "who": "mags", "line": "Parcel's in. That's breakfast earned. Come home, kid."},
  {"at": [0, 13, -119], "radius": 6, "who": "mags", "line": "Big drop. Crouch just before you land and roll out of it."},
  {"at": [1.5, 4, -150], "radius": 9, "who": "mags", "line": "Parker... the camp's gone quiet. Echo isn't answering."},
  {"at": [0, 4, -168], "radius": 8, "who": "mags", "line": "Something's wrong. Move."},
  {"on": "complete", "who": "host", "line": "Goooood morning, Port Calder! This is the Host, on the only frequency you've got left."},
  {"on": "complete", "who": "host", "line": "Today's show: a courier comes home to an empty camp. His lovely wife? Gone. Tragic. Riveting."},
  {"on": "complete", "who": "host", "line": "Echo's with me, fixing my tower. Parker, darling, come and get her. The whole city's listening."},
  {"on": "complete", "who": "mags", "line": "Parker. Don't you dare go alone. Come to the yard first."}
 ],
