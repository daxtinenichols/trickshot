  {"on": "checkpoint:0", "who": "mags", "line": "That door's been stuck since the storm. Kick it in. Or use the window, if you're feeling polite."},
  {"at": [4, 10, -66], "radius": 7, "who": "mags", "line": "You won't jump that one. Run the wall."},
  {"on": "checkpoint:1", "who": "mags", "line": "High roof's up that wall. Go straight at it and jump."},
  {"on": "done:0", "who": "mags", "line": "Parcel's in. Good. Come on home, kid."},
  {"at": [0, 13, -119], "radius": 6, "who": "mags", "line": "Big drop here. Crouch right before you hit and roll it out."},
  {"on": "complete", "who": "host", "line": "Gooood morning, Port Calder! It's your Host, on the, uh, only frequency you've got left. Lucky you."},
  {"on": "complete", "who": "host", "line": "So, today's show. We've got a courier, comes home, and his camp's empty. Wife's gone. I know! Awful. I can't stop listening either."},
  {"on": "complete", "who": "host", "line": "Echo's up here with me, fixing my tower. Lovely hands. Parker, darling, come and get her. Everybody's listening."},
  {"on": "complete", "who": "mags", "line": "Parker. Parker, listen to me. You are not going alone. Yard first."}
