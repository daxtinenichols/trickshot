  },
  {
   "who": "mags",
   "line": "...Keep moving, love.",
   "must": true,
   "keep": true,
   "on": "set_piece:juno_crane"
  },
  {
   "who": "parker",
   "line": "That was Juno.",
   "must": true,
   "keep": true,
   "on": "set_piece:juno_crane"
  },
  {
   "who": "mags",
   "line": "I know who it was. Keep moving.",
   "must": true,
   "keep": true,
   "on": "set_piece:juno_crane"
  },
  {
   "who": "mags",
   "line": "That mast's their relay. Get past it and they lose you. Wall's on your left this time.",
   "on": "checkpoint:6",
   "cue": true
  },
  {
   "who": "host",
   "line": "He's quick, folks! Quicker than the last three couriers I had. Rest in pieces, boys.",
