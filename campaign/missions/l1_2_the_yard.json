  {"on": "go", "who": "mags", "line": "I know you want to go after her. You're running the yard first. Once. Humor me."},
  {"on": "objective:0", "who": "mags", "line": "Chain three different moves before your feet settle. Vault, slide, flip, wall, whatever you like. Just don't stop."},
  {"on": "done:0", "who": "mags", "line": "There it is. His listeners love that stuff, and right now you want them on your side."},
  {"on": "set_piece:handoff", "who": "mags", "line": "Here. This was your granddad's. Older than you, and it still shoots better than you do.", "must": true},
  {"on": "objective:1", "who": "mags", "line": "Scrap dummies. Hit 'em while you're moving. Nobody out there's gonna stand still for you."},
  {"on": "objective:2", "who": "mags", "line": "Now go for the heads. The Static plate their chests. Not their faces."},
  {"on": "objective:3", "who": "mags", "line": "Last one. All of it at once. Shoot mid-combo and it counts for more."},
  {"on": "done:3", "who": "mags", "line": "Alright. That's as ready as anybody gets for something this stupid."},
  {"on": "objective:4", "who": "mags", "line": "South gate, then the warehouses. I'll be in your ear the whole way, okay?"},
  {"on": "tape", "who": "host", "line": "...and that's the weather. Margaret, is it raining? Is that right?", "fx": "tape", "must": true},
  {"on": "tape", "who": "mags", "line": "Look out the window, Rook.", "fx": "tape", "must": true},
  {"on": "tape", "who": "host", "line": "I'm not paid to look out windows. I'm paid to talk.", "fx": "tape", "must": true},
  {"on": "complete", "who": "parker", "line": "Thanks, Mags."},
  {"on": "complete", "who": "mags", "line": "Just come back. Both of you.", "must": true},
  {"on": "time:90", "who": "host", "line": "Still on the playground, Parker? Echo says you're always late. She's not wrong, is she?"}
