 "radio": [
  {"on": "start", "who": "host", "line": "Welcome to the Meridian Mall, folks! Tonight's main event: one courier versus a whole lot of hungry neighbours."},
  {"on": "start", "who": "mags", "line": "It's an arena, Parker. You don't have to fight. Just get through it."},
  {"on": "go", "who": "host", "line": "Open the gates! Let 'em out!"},
  {"on": "checkpoint:0", "who": "mags", "line": "Careful. Every shot you fire brings more of them."},
  {"at": [0, 3, -36], "size": [60, 12, 6], "who": "mags", "line": "Those ones jump. Watch the ledges up top, not the floor."},
  {"on": "checkpoint:1", "who": "host", "line": "And he's into the food court! Sorry, folks, food court's closed. Has been for twenty years."},
  {"at": [0, 3, -85], "size": [60, 8, 6], "who": "mags", "line": "He's shut the concourse. Escalator, your left. Then up on the walkways.", "cue": true},
  {"at": [-10.5, 7.5, -138], "size": [8, 4, 6], "who": "mags", "line": "Over the bridge. Walkway's caved in past the shops. Take the plank, or run the hoarding.", "cue": true},
  {"at": [0, 5, -180], "size": [48, 12, 6], "who": "host", "line": "This segment is brought to you by the Ward. Clean water, for people who know their place."},
  {"on": "complete", "who": "host", "line": "He made it to the anchor store! Folks, I'm entertained, and I'm furious about it."}
 ],
 "chatter": {
  "kill": [
   {"who": "host", "line": "Down goes another! Folks, I'm starting to feel sorry for them. No, I'm not."},
   {"who": "mags", "line": "Good. Don't wait for the next one, go."},
   {"who": "host", "line": "Splat! Right by the fountain, too. Nobody's drinking that."},
   {"who": "mags", "line": "That's one. Keep your head up, they jump."},
   {"who": "host", "line": "And down goes another one! The crowd goes mild."},
   {"who": "mags", "line": "Good. Now keep moving."}
  ],
  "headshot": [
   {"who": "host", "line": "Oh! Right in the... well, I think that was the head."},
   {"who": "mags", "line": "Good shot."},
   {"who": "host", "line": "Pop! Hear that? That's the sound of ratings."},
   {"who": "mags", "line": "Nice. Watch the railings, they come over."},
   {"who": "host", "line": "Right between the eyes! Run that back!"}
  ],
  "down": [
   {"who": "host", "line": "And he's lunch! Oh, no, wait, he's back. Never mind."},
   {"who": "mags", "line": "Up. Keep moving, they'll swarm you if you stop."},
   {"who": "host", "line": "Courier down in the Atrium! Mind your step, it's very... chewy in there."},
   {"who": "host", "line": "Ooh! That one's going in the highlights."},
   {"who": "mags", "line": "Up. Don't stand still in here."}
  ],
  "bail": [
   {"who": "host", "line": "Oops! Slippery floors, folks. We'd sue, but, you know."},
   {"who": "host", "line": "And down he goes in front of everyone. Mortifying."},
   {"who": "mags", "line": "Up, quick."},
   {"who": "host", "line": "He fell! Somebody find a wet floor sign. Does anybody still have a wet floor sign?"},
   {"who": "host", "line": "He's down! No, he's up. Disappointing."}
  ],
  "combo": [
   {"who": "host", "line": "Folks, this is better than the fountain show. There used to be a fountain show."},
   {"who": "mags", "line": "Lovely. Keep it."},
   {"who": "host", "line": "Ugh. Fine. That was good. Happy?"},
   {"who": "host", "line": "Folks, I hate to say it, but that was beautiful."},
   {"who": "mags", "line": "That's it. Give 'em a show."}
  ],
  "tape": [
   {"who": "echo", "line": "...this mall had the last clean taps in Port Calder. Somebody turned them off. Ask who."}
  ]
 },
