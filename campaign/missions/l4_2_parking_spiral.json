 "radio": [
  {
   "on": "start",
   "who": "mags",
   "line": "That's Juno. She ran the Line with you, Parker. She knows all your tricks."
  },
  {
   "on": "start",
   "who": "juno",
   "line": "Hey, Parker. Long time. Still running for other people?",
   "must": true
  },
  {
   "on": "go",
   "who": "parker",
   "line": "Still running.",
   "must": true
  },
  {
   "on": "checkpoint:1",
   "who": "host",
   "line": "Folks, it's a rematch! Nobody asked for it, and you're all gonna love it."
  },
  {
   "on": "juno:phase:1",
   "who": "juno",
   "line": "You were always faster. I'm the one getting paid, though."
  },
  {
   "on": "checkpoint:3",
   "who": "juno",
   "line": "You want to know how they found your camp? I drew them the routes. All of them.",
   "must": true
  },
  {
   "on": "checkpoint:3",
   "who": "parker",
   "line": "Why?",
   "must": true
  },
  {
   "on": "checkpoint:3",
   "who": "juno",
   "line": "Kettle Row's had no water for two years, Parker. My brother's eleven. Work it out.",
   "must": true
  },
  {
   "on": "juno:phase:2",
   "who": "mags",
   "line": "She's not lying. Doesn't make it alright.",
   "must": true
  },
  {
   "on": "checkpoint:4",
   "who": "juno",
   "line": "Come on, then. Show the city."
  },
  {
   "on": "fate:spared",
   "who": "juno",
   "line": "Go on. Get her. Before I change my mind.",
   "must": true
  },
  {
   "on": "fate:not_spared",
   "who": "mags",
   "line": "...She was one of ours, once. Keep going.",
   "must": true
  },
  {
   "on": "complete",
   "who": "host",
   "line": "Well. Ratings are through the roof. And you're all cheering for the wrong guy. Every one of you.",
   "must": true
  },
  {
   "on": "complete",
   "who": "host",
   "line": "Let's, uh... let's take a quick break. Word from our sponsor.",
   "must": true
  },
  {
   "on": "complete",
   "who": "vell",
   "line": "Port Calder. This is Commander Vell of the Ward. This broadcast has become a public safety concern. We'll be resolving it.",
   "must": true
  },
  {
   "on": "complete",
   "who": "mags",
   "line": "Parker. Those aren't raiders.",
   "must": true
  }
 ],
 "chatter": {
  "kill": [
   {
    "who": "juno",
    "line": "Wow. Okay. You're gonna owe me a crew."
   },
   {
    "who": "host",
    "line": "Juno, sweetheart, these are your people! Do something!"
   },
   {
    "who": "juno",
    "line": "Huh. Didn't like him anyway."
   },
   {
    "who": "mags",
    "line": "Good. Watch the ramps, they come round fast."
   },
   {
    "who": "host",
    "line": "Another hunter down! I'm docking their pay. Posthumously."
   },
   {
    "who": "juno",
    "line": "That one owed me money. Thanks, I guess."
   }
  ],
  "headshot": [
   {
    "who": "juno",
    "line": "Hm. Lucky."
   },
   {
    "who": "host",
    "line": "Ooh, right between the eyes! In my car park!"
   },
   {
    "who": "mags",
    "line": "Good. Keep moving."
   },
   {
    "who": "juno",
    "line": "Okay, that one was actually nice."
   },
   {
    "who": "juno",
    "line": "Clean. Mags teach you that?"
   }
  ],
  "down": [
   {
    "who": "juno",
    "line": "That's it? Get up, you're embarrassing both of us."
   },
   {
    "who": "host",
    "line": "Courier down on level... what level is this? Somebody count."
   },
   {
    "who": "mags",
    "line": "Up. Keep going round, don't let them pin you."
   },
   {
    "who": "juno",
    "line": "Up you get, courier. I'm not done with you."
   },
   {
    "who": "mags",
    "line": "Up. She wants you to stop. Don't."
   }
  ],
  "bail": [
   {
    "who": "juno",
    "line": "Ha! Oh, that was beautiful."
   },
   {
    "who": "host",
    "line": "Ooh, tyre marks! On his face."
   },
   {
    "who": "mags",
    "line": "Up, kid."
   },
   {
    "who": "juno",
    "line": "You used to be better at this."
   },
   {
    "who": "host",
    "line": "Oh, he's eaten the concrete! Somebody park on him."
   }
  ],
  "combo": [
   {
    "who": "juno",
    "line": "Fine. That was good. Don't make it weird."
   },
   {
    "who": "mags",
    "line": "Lovely. Keep spinning up."
   },
   {
    "who": "juno",
    "line": "Show-off. You haven't changed."
   },
   {
    "who": "host",
    "line": "Look at those lines! Somebody stop him, he's making me look bad."
   }
  ],
  "tape": [
   {
    "who": "echo",
    "line": "...Juno never took his money till her block's taps ran dry. Somebody shut them off. Remember that before you judge her."
   },
   {
    "who": "echo",
    "line": "...Juno ran a parcel through a fire for us once. Ask her about it sometime."
   }
  ]
