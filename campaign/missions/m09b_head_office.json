 "radio": [
  {"on": "start", "who": "mags", "line": "That's Calder House. Radio people built it, back when radio was a job. He runs the show from in there."},
  {"on": "go", "who": "host", "line": "Big treat tonight, folks. I'm coming down to say hello. In person! Don't wait up."},
