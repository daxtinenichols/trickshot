  {"on": "host:hit:1", "who": "host", "line": "Ow! Ow. Okay. That's coming out of your fee."},
  {"on": "host:hit:2", "who": "host", "line": "Will somebody shoot him? I pay you people!"},
  {"on": "host:run:1", "who": "host", "line": "Back in five, folks. Don't touch that dial."},
  {"on": "checkpoint:2", "who": "vell", "line": "You were told to stay in the studio."},
