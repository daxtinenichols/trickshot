; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Trickshot"
config/description="Movement sandbox prototype: parkour movement for a trick-shot arena shooter."
run/main_scene="res://levels/sandbox.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

InputSetup="*res://autoload/input_setup.gd"
Settings="*res://autoload/settings.gd"
ArtLook="*res://art/look/art_look.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/vsync/vsync_mode=0

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="kickable"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8

[rendering]

anti_aliasing/quality/msaa_3d=2
